         <ab><roleName ref="Q107207194" xml:id="f17v01_Mon_pere">Mon pere</roleName>
            <subst>
               <del>ainsy né, <add facs="#f17v01_i_dun_Mammes" xml:id="f17v01_dun_Mammes_add"><del
                        seq="2" facs="#f17v01_i_dun_maison" xml:id="f17v01_dun_maison">d<choice>
                           <orig/>
                           <reg>'</reg>
                        </choice>un gentilhome de ceste maison</del>
                     <del seq="1" facs="#f17v01_i_de_Mammes" xml:id="f17v01_de_Mammes">de
                           <surname>Mammes</surname></del></add> et d<choice>
                     <orig/>
                     <reg>'</reg>
                  </choice><seg xml:id="f17v01_une_Cauna">une damoyselle qui estoit de
                        <surname>Cauna</surname></seg>, <subst>
                     <del facs="#f17v01_i_maison_del" xml:id="f17v01_maison_del">maison</del>
                     <del facs="#f17v01_i_bone_famille" xml:id="f17v01_bone_famille_del"><add
                           facs="#f17v01_i_bone_famille" xml:id="f17v01_bone_famille_add">bone
                           famille</add></del>
                     <add facs="#f17v01_i_maison_add" xml:id="f17v01_maison_add">maison</add>
                  </subst><substJoin seq="1"
                     target=" #f17v01_dun_Mammes_add #f17v01_maison_del #f17v01_bone_famille_add"
                     /><substJoin seq="2"
                     target=" #f17v01_dun_maison #f17v01_bone_famille_del #f17v01_maison_add"/>
                  cognue en <placeName ref="Q191085"><choice>
                        <orig>g</orig>
                        <reg>G</reg>
                     </choice>ascoigne</placeName>, fut neantmoins instruit aux letres pource qu<choice>
                     <orig/>
                     <reg>'</reg>
                  </choice>il estoit né <choice>
                     <orig>a</orig>
                     <reg>à</reg>
                  </choice> sept mois et fort <subst>
                     <del>delicat</del>
                     <add>delié</add>
                  </subst> en <metamark function="insert" target="f17v01_sa">^</metamark><add
                     facs="#f17v01_i_sa" xml:id="f17v01_sa">sa</add>
                  <choice>
                     <orig>i</orig>
                     <reg>j</reg>
                  </choice>eunesse.</del>
               <add xml:id="f17v01_a_ieunesse"><gap unit="char" quantity="1"/><supplied cert="high"
                     >a</supplied> sa naissance n<choice>
                     <!--                     « a » sa naissance : supplied, mais faudrait-il régulariser ?-->
                     <orig> </orig>
                     <reg>'</reg>
                  </choice>a<choice>
                     <orig>u</orig>
                     <reg>v</reg>
                  </choice>oit <gap unit="char" quantity="1"/><supplied cert="high">q</supplied>ue
