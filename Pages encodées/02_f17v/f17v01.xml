                     <reg>E</reg>
                  </choice>t pource <gap unit="char" quantity="1"/><supplied cert="high"
                     >q</supplied>u<choice>
                     <orig/>
                     <reg>'</reg>
                  </choice>il ne prometoit pas <subst>
                     <del seq="1">longue vie il fut</del>
                     <del seq="2"><add seq="1">gra<gap reason="deleted"/></add></del>
                     <add seq="2">grande force, il fut</add>
                  </subst><subst>
                     <del>norry</del>
                     <add>dedié</add>
                  </subst> aux <choice>
                     <abbr rend="overlined">lres</abbr>
                     <expan>letres</expan>
