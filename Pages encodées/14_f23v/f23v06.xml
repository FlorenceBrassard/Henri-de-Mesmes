                    une <choice>
                        <abbr><g ref="#pro-glyph">ꝑ</g></abbr>
                        <expan>pro</expan>
                    </choice>messe d<subst facs="#f23v06_i_e_un" instant="true" xml:id="f23v06_e_un">
